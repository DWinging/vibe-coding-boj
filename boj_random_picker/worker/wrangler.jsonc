{
  "name": "boj-random-picker-api",
  "main": "index.js",
  "compatibility_date": "2026-11-20",
  "workers_dev": true,
  "vars": {
    "EXTENSION_IDS": "ijfpnmabjoobcklmokacphodhmechhdk,chbfbmgdfjoabckohpopnmhcagchcpem"
  },
  "durable_objects": {
