{
  "manifest_version": 3,
  "name": "BOJ Random Picker",
  "version": "3.0.1",
  "minimum_chrome_version": "116",
  "description": "조건에 맞는 백준 문제를 랜덤하게 추출합니다.",
  "permissions": [
    "storage",
    "identity"
  ],
  "host_permissions": [
    "https://boj-random-picker-api.choi-dongwook20.workers.dev/*"
  ],
  "background": {
    "service_worker": "js/background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon.png"
  },
  "icons": {
    "128": "icons/icon.png"
  }
}
